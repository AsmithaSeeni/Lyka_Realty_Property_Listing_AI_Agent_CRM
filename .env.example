# Lyka Realty AI — environment configuration
# PLACEHOLDERS ONLY. Copy to `.env` and fill in real values.
# `.env` is gitignored — never commit real credentials.

# ---------------- Runtime ----------------
# development | test | production
APP_ENV=development
# Debug details (stack traces etc.). Safe default: false. Enable only locally.
DEBUG=false

# ---------------- NVIDIA chat (existing conversational AI — required) ----------------
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Same key/endpoint; used for Tamil-script, Tanglish and mixed-language turns.
NVIDIA_MODEL_TAMIL=nvidia/nemotron-3-super-120b-a12b

# ---------------- OpenAI (Phase 3 — staff-only structured lead extraction) ----------------
# Used ONLY by POST /api/agent/leads/extract (staff review tool). Customer
# chat never routes through OpenAI. Leave the key empty to disable extraction
# (the endpoint then returns a safe 503; everything else keeps working).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=1

# ---------------- Voice: speech-to-text (optional) ----------------
STT_PROVIDER=
STT_API_KEY=
STT_MODEL=

# ---------------- Voice: text-to-speech ----------------
# Providers: sarvam (recommended) | edge-tts (free, no key needed) | nvidia | openai
TTS_PROVIDER=sarvam
TTS_API_KEY=
TTS_MODEL=bulbul:v4-flash
TTS_VOICE=neha_mr_narration

# ---------------- Sarvam AI (Bulbul v4 Flash TTS & Speech) ----------------
# Get key at https://www.sarvam.ai/
SARVAM_API_KEY=

# ---------------- Database ----------------
# Leave EMPTY to use the active database: backend/real_estate.db (absolute,
# CWD-independent). Setting this value is the ONLY way to use a different
# database file. The repo-root real_estate.db is stale — never point here
# implicitly.
DATABASE_URL=
# Turso/libSQL auth token (production). Required when DATABASE_URL uses the
# libsql:// or https:// scheme. Server-side only — never exposed to browsers.
TURSO_AUTH_TOKEN=

# ---------------- SQLite connection safety (Phase 9) ----------------
# Applied to every SQLite connection via the app.database connect hook:
# foreign_keys=ON (always), plus these two knobs.
# Busy timeout in seconds — how long a writer waits for a locked database.
SQLITE_BUSY_TIMEOUT_SECONDS=5
# Journal mode: wal (default; readers don't block the writer) or delete
# (legacy rollback journal). Unknown values are ignored. The chosen mode
# persists in the database file once set; synchronous durability stays FULL.
SQLITE_JOURNAL_MODE=wal

# ---------------- Seeded CRM accounts (created on first run only) ----------------
SEED_ADMIN_EMAIL=
SEED_ADMIN_USERNAME=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=
SEED_AGENT_EMAIL=
SEED_AGENT_USERNAME=
SEED_AGENT_NAME=
SEED_AGENT_PASSWORD=

# ---------------- CORS ----------------
# Comma-separated origins. EMPTY = safe local defaults
# (http://localhost:5173, http://127.0.0.1:5173, localhost/127.0.0.1:8000).
# "*" is rejected when APP_ENV=production.
CORS_ORIGINS=

# ---------------- Rate limiting (per application process, in-memory) ----------------
# NOT a distributed production rate limiter: counters reset on restart and
# are not shared between workers. 0 = disable a bucket.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
CHAT_RATE_LIMIT=60
AUTH_RATE_LIMIT=15
VOICE_RATE_LIMIT=30

# ---------------- Request-size / input-length limits ----------------
REQUEST_MAX_BYTES=5242880
VOICE_UPLOAD_MAX_BYTES=5242880
CHAT_MESSAGE_MAX_CHARS=4000
SYNTHESIZE_TEXT_MAX_CHARS=5000

# ---------------- Cookies ----------------
# Secure flag on session cookies. EMPTY = automatic (true when
# APP_ENV=production, false otherwise). Set true when served over HTTPS.
COOKIE_SECURE=

# ---------------- Global login & RBAC (Phase 6 — account lockout) ----------------
# After N CONSECUTIVE failed sign-ins on one EXISTING account, lock it for
# M minutes. Counters reset on a successful login. A locked account returns the
# same generic error as a wrong password (no lock-detection oracle). This brakes
# targeted password-spraying; the per-IP AUTH_RATE_LIMIT already damps volume.
# The threshold is clamped to a minimum of 1 — lockout cannot be disabled
# (a value below 1 behaves like 1).
LOGIN_LOCKOUT_THRESHOLD=8
LOGIN_LOCKOUT_MINUTES=15
